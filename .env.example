# Civora environment template — copy to .env.local (or .env) and fill in.
#
# Production requires DATABASE_URL, SESSION_SECRET and an object-storage
# driver. The application fails loudly rather than falling back to a
# guessable default; /api/health reports anything still missing.

# ──────────────────────────────────────────────────────────────── database
# PostgreSQL connection used at runtime. Use the pooled URL if your provider
# offers one (Neon, Supabase, PgBouncer).
#
# On Vercel, connecting a Postgres store is enough: POSTGRES_URL and
# POSTGRES_URL_NON_POOLING are injected automatically and used as fallbacks,
# so neither variable below needs setting by hand.
DATABASE_URL="postgresql://user:password@localhost:5432/civora?schema=public"
# Unpooled connection, used only by `prisma migrate`. Set it when DATABASE_URL
# points at a transaction pooler; otherwise leave it unset.
# DIRECT_URL="postgresql://user:password@localhost:5432/civora?schema=public"
# Connections per instance. Lower it on serverless platforms.
# DATABASE_POOL_MAX=5

# ──────────────────────────────────────────────────────────────── sessions
# Required in production. At least 32 characters: openssl rand -hex 32
SESSION_SECRET=""
# Idle timeout and hard ceiling for a responder session.
# SESSION_IDLE_MINUTES=60
# SESSION_MAX_HOURS=8

# ────────────────────────────────────────────────────────── object storage
# Where evidence bytes live. Never a public bucket: Civora streams files
# through its own authorization check and hands out no storage URLs.
#   s3            — any S3-compatible service (AWS S3, Cloudflare R2, MinIO…)
#   vercel-blob   — Vercel Blob, always with private access
#   local         — development only; refused when NODE_ENV=production
#
# On Vercel, connecting a Blob store is enough: BLOB_READ_WRITE_TOKEN is
# injected and the driver resolves to vercel-blob on its own.
OBJECT_STORAGE_DRIVER="local"
OBJECT_STORAGE_LOCAL_DIR=".data/evidence"
# OBJECT_STORAGE_BUCKET="civora-evidence"
# OBJECT_STORAGE_REGION="auto"
# OBJECT_STORAGE_ENDPOINT="https://s3.eu-west-1.amazonaws.com"
# OBJECT_STORAGE_ACCESS_KEY_ID=""
# OBJECT_STORAGE_SECRET_ACCESS_KEY=""
# OBJECT_STORAGE_FORCE_PATH_STYLE=true
# OBJECT_STORAGE_PREFIX="evidence"
# Required when OBJECT_STORAGE_DRIVER=vercel-blob:
# BLOB_READ_WRITE_TOKEN=""

# Upload constraints, enforced server-side against the file's actual bytes.
# UPLOAD_MAX_MB=8
# UPLOAD_MAX_FILES=6

# ───────────────────────────────────────────────────────────── rate limits
# Redis-compatible REST endpoint (e.g. Upstash). Without it, counters live in
# PostgreSQL — still shared across instances, just a little slower.
# REDIS_REST_URL=""
# REDIS_REST_TOKEN=""

# ────────────────────────────────────────────────────────────────────── AI
# "mock" runs Civora's own deterministic analyzer and no external calls.
# "openai" enables model-backed summaries, plain-language rewriting and
# translation. Translation is only offered when a provider is actually
# configured; Civora never fabricates one.
AI_PROVIDER="mock"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# AI_TIMEOUT_MS=12000
# AI_MAX_INPUT_CHARS=6000
# Deployment-wide ceiling on live provider calls per day.
# AI_DAILY_QUOTA=500

# ──────────────────────────────────────────────────────────────── demo mode
# Off in production unless deliberately switched on. Demo mode enables the
# shared responder access code and plants demo tracking tokens on a visitor's
# device; ENABLE_DEMO_TOOLS additionally exposes the dataset reset.
CIVORA_DEMO_MODE="true"
ENABLE_DEMO_TOOLS="true"
# The code below falls back to civora-demo only outside production. A production
# build has no fallback: set this, or demo sign-in is refused as unconfigured.
DEMO_RESPONDER_CODE="civora-demo"
# Password for the seeded demo accounts. Randomised and printed by the seed
# script when this is not set.
# DEMO_RESPONDER_PASSWORD=""

# ──────────────────────────────────────────────────────────────── retention
# RETENTION_EVIDENCE_DAYS=365
# RETENTION_CONTACT_DAYS=180

# ─────────────────────────────────────────────────────────────────── other
# The deployment's own origin. On Vercel this resolves from the injected
# deployment host, so it only needs setting for a custom domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# LOG_LEVEL="info"

# Emergency and referral contacts shown on the Get help page. Civora ships
# none: a fictional number shown to someone in danger is worse than none at
# all. Leave this unset and the page explains that it is unconfigured.
# EMERGENCY_CONTACTS='[{"name":"Local emergency line","detail":"24 hours","phone":"112"}]'
