# Civora environment template — copy to .env.local and adjust.
# The app runs with sensible demo defaults even when this file is absent.

# Secret used to sign the responder session cookie (change in production)
SESSION_SECRET=change-me-in-production

# Access code for the demo responder workspace
DEMO_RESPONDER_CODE=civora-demo

# Storage locations (relative to project root)
DATA_DIR=data

# Upload constraints
UPLOAD_MAX_MB=8

# Emergency / referral contacts shown on the Resources page and safety path.
# Leave empty to show configuration guidance instead of contacts.
EMERGENCY_CONTACTS=[{"name":"Example campus safety desk","detail":"Sample placeholder — configure your local services","phone":""}]

# AI provider abstraction: "mock" (deterministic, no external calls) or "openai"
AI_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
